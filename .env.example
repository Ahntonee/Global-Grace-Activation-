PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app-name>

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Public site origin (drives CORS + Socket.io in production)
FRONTEND_URL=http://localhost:5000

# First-admin bootstrap (used once by src/scripts/seedAdmin.js, then can be removed)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change_me_before_running

# Payments — leave PAYMENT_MODE=mock until real gateway keys are supplied
PAYMENT_MODE=mock
# Gateways accepted at checkout/giving (comma-separated). Flutterwave only for now.
PAYMENT_PROVIDERS=flutterwave
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=
PAYMENT_CALLBACK_BASE_URL=http://localhost:5000

# Email — leave MAIL_MODE=mock until a real Resend API key is supplied.
# In mock mode, emails are logged to the console instead of sent.
MAIL_MODE=mock
RESEND_API_KEY=
MAIL_FROM="Global Grace Activation <hello@globalgraceactivation.com>"
MAIL_ADMIN_TO=hello@globalgraceactivation.com

# Live spreadsheet feed for Excel / Google Sheets (admin > Event Registrations).
# Optional — if blank, a stable token is derived from JWT_SECRET.
EXPORT_FEED_TOKEN=

# Number of reverse proxies in front of the app (GoDaddy/cPanel/nginx). Defaults to 1
# in production, 0 elsewhere. Needed so rate limiting sees each visitor's real IP.
# TRUST_PROXY=1
