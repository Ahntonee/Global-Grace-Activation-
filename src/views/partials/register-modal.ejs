<div class="modal-overlay" id="register-modal" aria-hidden="true">
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="register-modal-title">
    <button class="modal-close" id="register-modal-close" type="button" aria-label="Close">&times;</button>
    <span class="eyebrow">Secure your seat</span>
    <h3 id="register-modal-title">Register for GGA Global Conference 2026</h3>
    <form data-fake-submit data-success="You&#8217;re registered &mdash; check your email for your ticket!">
      <div class="field-row">
        <div class="field"><label>Full Name</label><input type="text" name="fullName" required placeholder="Your name"></div>
        <div class="field"><label>Phone Number</label><input type="tel" name="phone" required placeholder="+234&hellip;"></div>
      </div>
      <div class="field"><label>Email Address</label><input type="email" name="email" required placeholder="you@email.com"></div>
      <div class="field-row">
        <div class="field"><label>Country</label><input type="text" name="country" required placeholder="e.g. Nigeria"></div>
        <div class="field"><label>Guests Attending</label>
          <select name="guests"><option>Just me</option><option>2 people</option><option>3 people</option><option>4+ people</option></select>
        </div>
      </div>
      <button class="btn btn-primary btn-block" type="submit">Complete Registration</button>
    </form>
  </div>
</div>
