<%- include('./partials/header', { title: 'New event registration' }) %>
<h1 style="font-family:Georgia,serif; color:#064e3b; font-size:20px; margin:0 0 16px;">New event registration</h1>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f0fdf4; border-radius:8px; margin:0 0 14px;">
  <tr><td style="padding:16px 18px; font-family:Arial,Helvetica,sans-serif; font-size:13.5px; color:#374151; line-height:1.9;">
    <strong style="color:#064e3b;">Name:</strong> <%= fullName %> &lt;<%= email %>&gt;<br>
    <strong style="color:#064e3b;">Phone:</strong> <%= phone %><br>
    <strong style="color:#064e3b;">Country:</strong> <%= country %><br>
    <strong style="color:#064e3b;">Event:</strong> <%= eventTitle %><br>
    <strong style="color:#064e3b;">Guests:</strong> <%= guests %>
  </td></tr>
</table>
<a href="<%= adminUrl %>" style="display:inline-block; background:#10b981; color:#ffffff; padding:12px 22px; border-radius:999px; text-decoration:none; font-weight:700; font-size:13.5px;">View in Admin</a>
<%- include('./partials/footer') %>
