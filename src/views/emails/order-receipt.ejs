<%- include('./partials/header', { title: 'Your order confirmation' }) %>
<h1 style="font-family:Georgia,serif; color:#064e3b; font-size:20px; margin:0 0 16px;">Thank you, <%= customerName %>!</h1>
<p style="font-family:Arial,Helvetica,sans-serif; color:#374151; font-size:14.5px; line-height:1.7; margin:0 0 14px;">
  Your order <strong><%= orderNumber %></strong> is confirmed.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f0fdf4; border-radius:8px; margin:0 0 14px;">
  <% items.forEach(function(item) { %>
    <tr>
      <td style="padding:10px 18px; font-family:Arial,Helvetica,sans-serif; font-size:13.5px; color:#374151;"><%= item.name %> &times; <%= item.quantity %></td>
      <td style="padding:10px 18px; font-family:Arial,Helvetica,sans-serif; font-size:13.5px; color:#374151; text-align:right;">&#8358;<%= (item.unitPrice * item.quantity).toLocaleString() %></td>
    </tr>
  <% }) %>
  <tr>
    <td style="padding:10px 18px; font-family:Arial,Helvetica,sans-serif; font-size:14px; font-weight:700; color:#064e3b; border-top:1px solid #d1fae5;">Total</td>
    <td style="padding:10px 18px; font-family:Arial,Helvetica,sans-serif; font-size:14px; font-weight:700; color:#047857; text-align:right; border-top:1px solid #d1fae5;">&#8358;<%= total.toLocaleString() %></td>
  </tr>
</table>
<% if (digitalLinks && digitalLinks.length) { %>
  <p style="font-family:Arial,Helvetica,sans-serif; color:#374151; font-size:14.5px; line-height:1.7; margin:0 0 8px;"><strong>Your digital items:</strong></p>
  <p style="font-family:Arial,Helvetica,sans-serif; color:#374151; font-size:13.5px; line-height:1.9; margin:0 0 14px;">
    <% digitalLinks.forEach(function(link) { %>
      &bull; <a href="<%= link.url %>" style="color:#047857;"><%= link.name %></a><br>
    <% }) %>
  </p>
<% } %>
<% if (requiresShipping) { %>
  <p style="font-family:Arial,Helvetica,sans-serif; color:#6b7280; font-size:13px; line-height:1.7; margin:0;">
    We'll email you shipping updates as your order is processed.
  </p>
<% } %>
<%- include('./partials/footer') %>
