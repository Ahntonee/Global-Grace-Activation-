<%- include('./partials/header', { title: 'Application received' }) %>
<h1 style="font-family:Georgia,serif; color:#064e3b; font-size:20px; margin:0 0 16px;">Welcome to the team, <%= fullName %>!</h1>
<p style="font-family:Arial,Helvetica,sans-serif; color:#374151; font-size:14.5px; line-height:1.7; margin:0 0 14px;">
  Your volunteer application for <strong><%= department %></strong> has been received. You'll be added to our WhatsApp coordination group shortly.
</p>
<p style="font-family:Arial,Helvetica,sans-serif; color:#6b7280; font-size:13px; line-height:1.7; margin:0;">
  If this wasn't you, you can safely ignore this email.
</p>
<%- include('./partials/footer') %>
