<header class="page-header">
  <div class="container">
    <span class="crumb"><%= txt('site.nav.home', 'Home', 'Menu — Home') %> &rsaquo; <span><%= txt('site.nav.faqs', 'FAQs', 'Menu — FAQs') %></span></span>
    <span class="eyebrow"><%= txt('faqs.intro.eyebrow', 'Good to know', 'Small label at the top') %></span>
    <h1 style="margin-top:18px;"><%= page.heroTitle %></h1>
    <p><%= page.heroSubtitle %></p>
  </div>
</header>

<section class="section-pad">
  <div class="container">
    <div style="max-width:760px; margin:0 auto;">
      <% faqs.forEach(function(faq) { %>
        <div class="accordion-item reveal">
          <button><%= faq.question %> <span class="plus">+</span></button>
          <div class="a-body"><p><%= faq.answer %></p></div>
        </div>
      <% }) %>
    </div>
    <div class="panel-dark reveal" style="text-align:center; margin-top:56px;">
      <span class="eyebrow" style="justify-content:center;"><%= txt('faqs.help.eyebrow', 'Still have questions?', 'Help box — small label') %></span>
      <h2 style="margin-top:16px; font-size:1.6rem;"><%= txt('faqs.help.title', 'We\'re happy to help', 'Help box — heading') %></h2>
      <a href="/contact" class="btn btn-primary" style="margin-top:20px;"><%= txt('faqs.help.button', 'Contact Us', 'Help box — button') %></a>
    </div>
  </div>
</section>
