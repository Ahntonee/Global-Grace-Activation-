<header class="page-header">
  <div class="container">
    <span class="crumb"><%= txt('site.nav.home', 'Home', 'Menu — Home') %> &rsaquo; <span><%= txt('site.nav.about', 'About', 'Menu — About') %></span></span>
    <span class="eyebrow"><%= txt('about.intro.eyebrow', 'Our story', 'Small label at the top') %></span>
    <h1 style="margin-top:18px;"><%= txt('about.intro.title', 'A decade of grace, carried across nations.', 'Page heading') %></h1>
    <p><%- rich('about.intro.subtitle', 'Global Grace Activation began as a single night of worship and has grown into a movement reaching over 25 nations — raising a generation that seeks God, walks in purpose, and influences the world.', 'Line under the heading') %></p>
  </div>
</header>

<section class="section-pad">
  <div class="container two-col">
    <div class="reveal">
      <span class="eyebrow"><%= txt('about.vision.eyebrow', 'Vision', 'Vision — small label') %></span>
      <h2 style="font-size:2.2rem; margin-top:16px;"><%= txt('about.vision.title', 'A generation fully alive in God, activated for global impact and Growth.', 'Vision — heading') %></h2>
      <p style="color:var(--mist); margin-top:18px; font-size:16px;"><%- rich('about.vision.body', 'We see a world where grace is understood not as a doctrine but as a daily reality — where believers everywhere are equipped to walk in their God-given destiny and carry transformation into their spheres of influence: family, business, government, media and the arts.', 'Vision — paragraph') %></p>
    </div>
    <div class="img-frame reveal"><img src="<%= cimg('about.story.photo1', '/images/worship-crowd-1.jpg', 'Story photo 1') %>" alt="Worshippers at a Global Grace Activation gathering" loading="lazy"></div>
  </div>
</section>

<section class="section-pad-sm" style="background:var(--paper-2);">
  <div class="container two-col">
    <div class="img-frame reveal" style="order:2;"><img src="<%= cimg('about.story.photo2', '/images/mission-photo.jpg', 'Story photo 2 (mission)') %>" alt="Global Grace Activation mission at work" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;"></div>
    <div class="reveal" style="order:1;">
      <span class="eyebrow"><%= txt('about.mission.eyebrow', 'Mission', 'Mission — small label') %></span>
      <h2 style="font-size:2.2rem; margin-top:16px;"><%= txt('about.mission.title', 'Ignite revival. Release destiny. Transform lives.', 'Mission — heading') %></h2>
      <p style="color:var(--mist); margin-top:18px; font-size:16px;"><%- rich('about.mission.body', 'Every gathering, broadcast and outreach exists to bring people into a real encounter with God — through worship, the Word, prayer and community — and to send them out equipped to live out that encounter long after the lights go down.', 'Mission — paragraph') %></p>
      <ul style="margin-top:24px; color:var(--mist); font-size:15px; display:flex; flex-direction:column; gap:12px;">
        <li>&#10003; <%= txt('about.mission.point1', 'Host an annual global gathering open to every nation', 'Mission — bullet 1') %></li>
        <li>&#10003; <%= txt('about.mission.point2', 'Stream every encounter free, to anywhere with a connection', 'Mission — bullet 2') %></li>
        <li>&#10003; <%= txt('about.mission.point3', 'Equip local churches with resources between gatherings', 'Mission — bullet 3') %></li>
        <li>&#10003; <%= txt('about.mission.point4', 'Fund missions & community projects through giving partners', 'Mission — bullet 4') %></li>
      </ul>
    </div>
  </div>
</section>

<section class="section-pad">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow"><%= txt('about.history.eyebrow', 'History', 'History — small label') %></span>
      <h2><%= txt('about.history.title', 'How the move began', 'History — heading') %></h2>
      <p><%= txt('about.history.intro', 'From one room of worshippers to a global broadcast reaching a thousand cities.', 'History — intro line') %></p>
    </div>
    <ul class="impact-list reveal-stagger" style="max-width:760px; margin:0 auto;">
      <li><span class="yr"><%= txt('about.history.year1', '2016', 'Timeline 1 — year') %></span><div><strong><%= txt('about.history.title1', 'The first gathering.', 'Timeline 1 — heading') %></strong><p style="color:var(--mist); margin-top:6px;"><%= txt('about.history.text1', 'A single night of worship in a rented hall in Lagos with fewer than 200 people in the room.', 'Timeline 1 — description') %></p></div></li>
      <li><span class="yr"><%= txt('about.history.year2', '2019', 'Timeline 2 — year') %></span><div><strong><%= txt('about.history.title2', 'Going national.', 'Timeline 2 — heading') %></strong><p style="color:var(--mist); margin-top:6px;"><%= txt('about.history.text2', 'GGA moved to Solution Arena and began partnering with churches across Nigeria.', 'Timeline 2 — description') %></p></div></li>
      <li><span class="yr"><%= txt('about.history.year3', '2021', 'Timeline 3 — year') %></span><div><strong><%= txt('about.history.title3', 'First global broadcast.', 'Timeline 3 — heading') %></strong><p style="color:var(--mist); margin-top:6px;"><%= txt('about.history.text3', 'The gathering streamed live for the first time, reaching viewers in 12 nations overnight.', 'Timeline 3 — description') %></p></div></li>
      <li><span class="yr"><%= txt('about.history.year4', '2024', 'Timeline 4 — year') %></span><div><strong><%= txt('about.history.title4', '500,000 lives.', 'Timeline 4 — heading') %></strong><p style="color:var(--mist); margin-top:6px;"><%= txt('about.history.text4', 'Combined in-person and online attendance crossed half a million across a single weekend.', 'Timeline 4 — description') %></p></div></li>
      <li><span class="yr"><%= txt('about.history.year5', '2026', 'Timeline 5 — year') %></span><div><strong><%= txt('about.history.title5', '25 nations and counting.', 'Timeline 5 — heading') %></strong><p style="color:var(--mist); margin-top:6px;"><%= txt('about.history.text5', 'GGA 2026 prepares to gather its largest crowd yet, with volunteer hubs in 25 nations.', 'Timeline 5 — description') %></p></div></li>
    </ul>
  </div>
</section>

<section class="section-pad-sm" style="background:var(--paper-2);">
  <div class="container two-col">
    <div class="reveal">
      <span class="eyebrow"><%= txt('about.founder.eyebrow', 'Founder', 'Founder — small label') %></span>
      <h2 style="font-size:2.1rem; margin-top:16px;"><%= txt('about.founder.name', 'Pastor Daniel Obi', 'Founder — name') %></h2>
      <p style="color:var(--mist); margin-top:16px; font-size:16px;"><%- rich('about.founder.bio', 'Pastor Daniel Obi convened the first Global Grace Activation gathering in 2016 out of a conviction that a generation was waiting for a genuine encounter with God, not another program. He continues to lead the movement\'s vision and ministers at every annual gathering, alongside pastoring a local congregation in Lagos.', 'Founder — biography') %></p>
    </div>
    <div class="leader-card reveal" style="text-align:left;">
      <div class="avatar" style="margin:0 0 18px; border-radius:20px; width:100%; height:280px; overflow:hidden;">
        <img src="<%= cimg('about.story.founderPhoto', '/images/pastor-portrait.jpg', 'Founder photo (Pastor Daniel Obi)') %>" alt="Portrait of Pastor Daniel Obi" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
      </div>
    </div>
  </div>
</section>

<section class="section-pad">
  <div class="container">
    <div class="panel-dark reveal">
      <span class="eyebrow"><%= txt('about.faith.eyebrow', 'Statement of faith', 'Statement of faith — small label') %></span>
      <h2 style="font-size:2rem; margin-top:18px;"><%= txt('about.faith.title', 'What we believe', 'Statement of faith — heading') %></h2>
      <div class="grid-2" style="margin-top:30px; color:var(--text); font-size:15px;">
        <div>
          <p style="margin-bottom:18px;"><strong style="color:var(--ink);"><%= txt('about.faith.name1', 'The Scriptures.', 'Belief 1 — title') %></strong> <%= txt('about.faith.text1', 'We believe the Bible is the inspired, authoritative Word of God.', 'Belief 1 — wording') %></p>
          <p style="margin-bottom:18px;"><strong style="color:var(--ink);"><%= txt('about.faith.name2', 'One God.', 'Belief 2 — title') %></strong> <%= txt('about.faith.text2', 'We believe in one God, eternally existing as Father, Son and Holy Spirit.', 'Belief 2 — wording') %></p>
          <p><strong style="color:var(--ink);"><%= txt('about.faith.name3', 'Salvation.', 'Belief 3 — title') %></strong> <%= txt('about.faith.text3', 'We believe salvation is a gift of grace received through faith in Jesus Christ.', 'Belief 3 — wording') %></p>
        </div>
        <div>
          <p style="margin-bottom:18px;"><strong style="color:var(--ink);"><%= txt('about.faith.name4', 'The Holy Spirit.', 'Belief 4 — title') %></strong> <%= txt('about.faith.text4', 'We believe in the present-day work and gifts of the Holy Spirit.', 'Belief 4 — wording') %></p>
          <p style="margin-bottom:18px;"><strong style="color:var(--ink);"><%= txt('about.faith.name5', 'The Church.', 'Belief 5 — title') %></strong> <%= txt('about.faith.text5', 'We believe the Church is God\'s family, called to worship, community and mission.', 'Belief 5 — wording') %></p>
          <p><strong style="color:var(--ink);"><%= txt('about.faith.name6', 'Eternity.', 'Belief 6 — title') %></strong> <%= txt('about.faith.text6', 'We believe in the bodily resurrection and the eternal reign of Christ.', 'Belief 6 — wording') %></p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow"><%= txt('about.leadership.eyebrow', 'Leadership', 'Small label') %></span>
      <h2><%= txt('about.leadership.title', 'The team behind the move', 'Heading') %></h2>
    </div>
    <div class="grid-4 reveal-stagger">
      <% leadership.forEach(function(leader) { %>
        <div class="leader-card">
          <div class="avatar"><img src="<%= leader.photo && leader.photo.url ? leader.photo.url : '/images/speaker-avatar.jpg' %>" alt="Portrait of <%= leader.name %>" loading="lazy"></div>
          <h4><%= leader.name %></h4>
          <div class="role"><%= leader.role %></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section-pad-sm" style="background:var(--paper-2);">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow"><%= txt('about.impact.eyebrow', 'Global impact', 'Small label') %></span>
      <h2><%= txt('about.impact.title', 'Reach at a glance', 'Heading') %></h2>
    </div>
    <div class="stats-row reveal-stagger">
      <div><div class="stat-num"><%= txt('about.impact.nations', '25+', 'Nations — number') %></div><div class="stat-label"><%= txt('about.impact.nationsLabel', 'Nations', 'Nations — wording') %></div></div>
      <div><div class="stat-num"><%= txt('about.impact.lives', '500K+', 'Lives Impacted — number') %></div><div class="stat-label"><%= txt('about.impact.livesLabel', 'Lives Impacted', 'Lives Impacted — wording') %></div></div>
      <div><div class="stat-num"><%= txt('about.impact.years', '10+', 'Years of Grace — number') %></div><div class="stat-label"><%= txt('about.impact.yearsLabel', 'Years of Grace', 'Years of Grace — wording') %></div></div>
      <div><div class="stat-num"><%= txt('about.impact.testimonies', '1,000+', 'Testimonies — number') %></div><div class="stat-label"><%= txt('about.impact.testimoniesLabel', 'Testimonies', 'Testimonies — wording') %></div></div>
    </div>
  </div>
</section>
