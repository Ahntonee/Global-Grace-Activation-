<header class="page-header">
  <div class="container">
    <span class="crumb"><%= txt('site.nav.home', 'Home', 'Menu — Home') %> &rsaquo; <a href="/blog"><%= txt('site.nav.blog', 'Blog', 'Menu — Blog') %></a> &rsaquo; <span><%= blog.title %></span></span>
    <span class="eyebrow"><%= blog.category %></span>
    <h1 style="margin-top:18px; max-width:820px;"><%= blog.title %></h1>
    <p style="max-width:680px;"><%= blog.excerpt %></p>
  </div>
</header>

<section class="section-pad">
  <div class="container" style="max-width:760px;">
    <%
      const postImages = (blog.images && blog.images.length ? blog.images : (blog.featuredImage ? [blog.featuredImage] : [])).filter(function(m) { return m && m.url; });
    %>
    <% if (postImages.length === 1) { %>
      <div class="img-frame reveal" style="margin-bottom:40px;"><img src="<%= postImages[0].url %>" alt="<%= blog.title %>" loading="lazy"></div>
    <% } else if (postImages.length > 1) { %>
      <div class="media-gallery reveal" style="margin-bottom:40px;">
        <% postImages.forEach(function(m, i) { %>
          <a href="<%= m.url %>" target="_blank" rel="noopener" class="img-frame"><img src="<%= m.url %>" alt="<%= blog.title %> — image <%= i + 1 %>" loading="lazy"></a>
        <% }) %>
      </div>
    <% } %>
    <div class="reveal" style="color:var(--text); font-size:16.5px; line-height:1.75;">
      <%- blog.content %>
    </div>
    <% if (blog.tags && blog.tags.length) { %>
      <div style="margin-top:36px; display:flex; gap:10px; flex-wrap:wrap;">
        <% blog.tags.forEach(function(tag) { %>
          <span class="pill"><%= tag %></span>
        <% }) %>
      </div>
    <% } %>
    <div style="margin-top:48px;">
      <a href="/blog" class="btn btn-ghost" style="padding-left:0;">&larr; <%= txt('blogpost.page.back', 'Back to all posts', 'Link at the bottom of a post') %></a>
    </div>
  </div>
</section>
