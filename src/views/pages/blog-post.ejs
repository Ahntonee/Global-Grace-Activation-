<header class="page-header">
  <div class="container">
    <span class="crumb">Home &rsaquo; <a href="/blog">Blog</a> &rsaquo; <span><%= blog.title %></span></span>
    <span class="eyebrow"><%= blog.category %></span>
    <h1 style="margin-top:18px; max-width:820px;"><%= blog.title %></h1>
    <p style="max-width:680px;"><%= blog.excerpt %></p>
  </div>
</header>

<section class="section-pad">
  <div class="container" style="max-width:760px;">
    <% if (blog.featuredImage && blog.featuredImage.url) { %>
      <div class="img-frame reveal" style="margin-bottom:40px;"><img src="<%= blog.featuredImage.url %>" alt="<%= blog.title %>" loading="lazy"></div>
    <% } %>
    <div class="reveal" style="color:var(--text); font-size:16.5px; line-height:1.75;">
      <%- blog.content %>
    </div>
    <% if (blog.tags && blog.tags.length) { %>
      <div style="margin-top:36px; display:flex; gap:10px; flex-wrap:wrap;">
        <% blog.tags.forEach(function(tag) { %>
          <span class="pill"><%= tag %></span>
        <% }) %>
      </div>
    <% } %>
    <div style="margin-top:48px;">
      <a href="/blog" class="btn btn-ghost" style="padding-left:0;">&larr; Back to all posts</a>
    </div>
  </div>
</section>
