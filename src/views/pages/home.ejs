<section class="hero">
  <div class="hero-slider" id="hero-slider">
    <div class="hero-slide active" data-slide="1"></div>
    <div class="hero-slide" data-slide="2"></div>
    <div class="hero-slide" data-slide="3"></div>
    <div class="hero-slide" data-slide="4"></div>
  </div>
  <div class="hero-video-wrap">
    <video class="hero-video" id="hero-video" autoplay muted loop playsinline poster="/hero-poster.jpg" style="display:block;">
      <source src="/hero-bg.mp4" type="video/mp4">
    </video>
  </div>
  <div class="hero-video-overlay"></div>
  <div class="hero-bg-image"></div>
  <div class="hero-glow"></div>
  <canvas id="ember-canvas"></canvas>
  <div class="hero-grid-lines"></div>
  <div class="container hero-content">
    <div class="hero-inner">
      <div>
        <div class="hero-flame-word">
          <span><% if (featuredEvent) { %><%= featuredEvent.title %><% } else { %>The Gathering<% } %></span>
        </div>
        <h1>
          <span class="split-line"><span>A global move of God.</span></span>
          <span class="split-line"><span>A generation <em>activated.</em></span></span>
        </h1>
        <p class="lede"><%= page.heroSubtitle || "Global Grace Activation is a worldwide movement raised to ignite revival, release destiny, and transform lives through the power of God — one encounter, spreading across nations." %></p>
        <div class="hero-cta-row">
          <a href="/events" class="btn btn-primary js-register-btn">Register Now</a>
          <a href="/watch-live" class="btn btn-outline">Watch Live</a>
        </div>
      </div>
      <div class="hero-panel">
        <span class="eyebrow">GGA Global Conference 2026</span>
        <h3>Experience Grace. Activate Destiny.</h3>
        <div class="countdown" <% if (featuredEvent) { %>data-event-date="<%= featuredEvent.startDate.toISOString() %>"<% } %>>
          <div class="c-cell"><div class="c-num" id="cd-days">00</div><div class="c-label">Days</div></div>
          <div class="c-cell"><div class="c-num" id="cd-hours">00</div><div class="c-label">Hours</div></div>
          <div class="c-cell"><div class="c-num" id="cd-mins">00</div><div class="c-label">Mins</div></div>
          <div class="c-cell"><div class="c-num" id="cd-secs">00</div><div class="c-label">Secs</div></div>
        </div>
        <ul class="hero-meta">
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg> December 4&ndash;5, 2026 &middot; 6PM&ndash;5AM</li>
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s7-7.4 7-12.5A7 7 0 0 0 5 9.5C5 14.6 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.5"/></svg> Solution Arena, Lagos, Nigeria</li>
        </ul>
      </div>
    </div>
  </div>
  <div class="scroll-cue"><span>SCROLL</span><span class="line"></span></div>
</section>

<section class="quicklinks">
  <div class="container">
    <a href="/events" class="ql-item js-register-btn">
      <span class="ql-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg></span>
      <strong>Register</strong><small>Secure your seat</small>
    </a>
    <a href="/watch-live" class="ql-item">
      <span class="ql-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="M16 10l6-3v10l-6-3"/></svg></span>
      <strong>Watch Live</strong><small>Join from anywhere</small>
    </a>
    <a href="/give" class="ql-item">
      <span class="ql-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7.5-4.9-10-9.2C.4 8.6 2 5 5.6 5c2 0 3.4 1 4.4 2.4C11 6 12.4 5 14.4 5 18 5 19.6 8.6 22 11.8 19.5 16.1 12 21 12 21z"/></svg></span>
      <strong>Give</strong><small>Partner with us</small>
    </a>
    <a href="/volunteer" class="ql-item">
      <span class="ql-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 11V5a2 2 0 1 1 4 0v5M11 10V4a2 2 0 1 1 4 0v6M15 10V6a2 2 0 1 1 4 0v8c0 4-2.5 6-6 6h-2c-3 0-4.5-1-6-3l-3-4.5c-.6-1 0-2.3 1.2-2.5 1-.2 1.8.3 2.3 1L7 13"/></svg></span>
      <strong>Volunteer</strong><small>Be part of the move</small>
    </a>
  </div>
</section>

<div class="divider-tape"><div class="track">
  <span><b>25+</b> Nations Reached</span><span><b>500K+</b> Lives Impacted</span><span><b>10+</b> Years of Grace</span><span><b>1,000+</b> Testimonies</span>
  <span><b>25+</b> Nations Reached</span><span><b>500K+</b> Lives Impacted</span><span><b>10+</b> Years of Grace</span><span><b>1,000+</b> Testimonies</span>
</div></div>

<section class="section-pad">
  <div class="container two-col">
    <div class="reveal">
      <span class="eyebrow">Who we are</span>
      <h2 style="font-size:clamp(1.9rem,3.4vw,2.7rem); margin-top:18px;">A move of God.<br>A global impact.</h2>
      <p style="color:var(--mist); font-size:16.5px; margin-top:20px; max-width:520px;">Global Grace Activation is a divine mandate to raise a generation that seeks God, walks in purpose, and influences the world &mdash; carried through worship, the Word, prayer and transformation across every nation we reach.</p>
      <div class="stats-row" style="margin-top:40px;">
        <div><div class="stat-num">25+</div><div class="stat-label">Nations</div></div>
        <div><div class="stat-num">500K+</div><div class="stat-label">Lives Impacted</div></div>
        <div><div class="stat-num">10+</div><div class="stat-label">Years of Grace</div></div>
        <div><div class="stat-num">1,000+</div><div class="stat-label">Testimonies</div></div>
      </div>
      <a href="/about" class="btn btn-ghost" style="margin-top:36px; padding-left:0;">Read our full story</a>
    </div>
    <div class="img-frame reveal"><img src="/images/worship-crowd-2.jpg" alt="Worship crowd at a Global Grace Activation gathering" loading="lazy"></div>
  </div>
</section>

<section class="section-pad-sm" style="background:var(--paper-2);">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow">Line-up</span>
      <h2>Voices carrying the message</h2>
      <p>Ministers and worship leaders converging from across the nations for this year&rsquo;s activation.</p>
    </div>
    <div class="grid-4 reveal-stagger">
      <% speakers.forEach(function(speaker) { %>
        <div class="card speaker-card">
          <div class="avatar"><img src="<%= speaker.photo && speaker.photo.url ? speaker.photo.url : '/images/speaker-avatar.jpg' %>" alt="Portrait of <%= speaker.name %>" loading="lazy"></div>
          <div class="body">
            <h4><%= speaker.name %></h4>
            <div class="role"><%= speaker.role %></div>
            <p><%= speaker.bio %></p>
          </div>
        </div>
      <% }) %>
    </div>
    <div style="text-align:center; margin-top:40px;"><a href="/speakers" class="btn btn-outline-dark">View Full Line-up</a></div>
  </div>
</section>

<section class="section-pad">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow">Real stories</span>
      <h2>Testimonies from the move</h2>
      <p>God is still changing lives. Here are a few stories from around the world.</p>
    </div>
    <div class="grid-4 reveal-stagger">
      <% testimonies.forEach(function(t) { %>
        <div class="card testimony-card" data-caption="<%= t.title %>">
          <div class="thumb">
            <img src="<%= t.thumbnail && t.thumbnail.url ? t.thumbnail.url : '/images/worship-stage.jpg' %>" alt="<%= t.title %>" loading="lazy">
            <span class="cat"><%= t.category %></span>
            <div class="play"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div>
          </div>
          <div class="body"><h4><%= t.title %></h4><small>Testimony<% if (t.location) { %> &middot; <%= t.location %><% } %></small></div>
        </div>
      <% }) %>
    </div>
    <div style="text-align:center; margin-top:40px;"><a href="/testimonies" class="btn btn-outline-dark">View All Testimonies</a></div>
  </div>
</section>

<section class="section-pad-sm" style="background:var(--paper-2);">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow">From the blog</span>
      <h2>Latest messages &amp; devotionals</h2>
    </div>
    <div class="grid-3 reveal-stagger">
      <% blogs.forEach(function(post) { %>
        <a href="/blog/<%= post.slug %>" class="card blog-card">
          <div class="thumb"><img src="<%= post.featuredImage && post.featuredImage.url ? post.featuredImage.url : '/images/worship-stage.jpg' %>" alt="<%= post.title %>" loading="lazy"></div>
          <div class="body">
            <span class="tag"><%= post.category %></span>
            <h4><%= post.title %></h4>
            <p><%= post.excerpt %></p>
            <div class="meta"><span><%= post.readTime || '5 min read' %></span><span><%= post.publishedAt ? post.publishedAt.toLocaleDateString('en-US',{month:'short',year:'numeric'}) : '' %></span></div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section-pad">
  <div class="container">
    <div class="center-head reveal" style="margin-bottom:36px;">
      <span class="eyebrow">Partners</span>
      <h2 style="font-size:1.6rem;">Standing with ministries &amp; sponsors worldwide</h2>
    </div>
    <div class="grid-4 reveal-stagger" style="text-align:center;">
      <div class="card" style="padding:26px; font-family:'Fraunces',serif; font-weight:600; color:var(--mist);">Grace Media Group</div>
      <div class="card" style="padding:26px; font-family:'Fraunces',serif; font-weight:600; color:var(--mist);">Kingdom Broadcast Network</div>
      <div class="card" style="padding:26px; font-family:'Fraunces',serif; font-weight:600; color:var(--mist);">Nations Arise Foundation</div>
      <div class="card" style="padding:26px; font-family:'Fraunces',serif; font-weight:600; color:var(--mist);">Solution Arena Lagos</div>
    </div>
  </div>
</section>

<section class="newsletter-bar">
  <div class="container" style="display:flex; justify-content:space-between; align-items:center; gap:30px; flex-wrap:wrap; position:relative; z-index:1;">
    <div style="max-width:420px;">
      <span class="eyebrow">Stay connected</span>
      <h2 style="color:var(--ink); font-size:1.8rem; margin-top:14px;">Get updates on events, messages &amp; more</h2>
    </div>
    <form class="newsletter-form" data-api-form data-endpoint="/api/newsletters/subscribe" data-success="You're subscribed — welcome to the family!">
      <input type="email" name="email" required placeholder="Enter your email address">
      <button class="btn btn-primary" type="submit">Subscribe</button>
    </form>
  </div>
</section>
