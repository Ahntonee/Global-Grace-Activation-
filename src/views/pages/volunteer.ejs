<header class="page-header">
  <div class="container">
    <span class="crumb"><%= txt('site.nav.home', 'Home', 'Menu — Home') %> &rsaquo; <span><%= txt('site.nav.volunteer', 'Volunteer', 'Menu — Volunteer') %></span></span>
    <span class="eyebrow"><%= txt('volunteer.intro.eyebrow', 'Serve with us', 'Small label at the top') %></span>
    <h1 style="margin-top:18px;"><%= page.heroTitle %></h1>
    <p><%= page.heroSubtitle %></p>
  </div>
</header>

<section class="section-pad">
  <div class="container two-col" style="align-items:start;">
    <div class="reveal">
      <span class="eyebrow"><%= txt('volunteer.departments.eyebrow', 'Departments', 'Departments — small label') %></span>
      <h2 style="font-size:1.8rem; margin:16px 0 22px;"><%= txt('volunteer.departments.title', 'Where you can serve', 'Departments — heading') %></h2>
      <div class="grid-2" style="gap:16px;">
        <div class="card" style="padding:20px;"><strong><%= txt('volunteer.departments.name1', 'Ushering & Guest Care', 'Department 1 — name') %></strong><p style="color:var(--mist); font-size:13.5px; margin-top:6px;"><%= txt('volunteer.departments.desc1', 'Welcome guests and manage seating on the ground.', 'Department 1 — description') %></p></div>
        <div class="card" style="padding:20px;"><strong><%= txt('volunteer.departments.name2', 'Media & Production', 'Department 2 — name') %></strong><p style="color:var(--mist); font-size:13.5px; margin-top:6px;"><%= txt('volunteer.departments.desc2', 'Cameras, streaming, sound and lighting.', 'Department 2 — description') %></p></div>
        <div class="card" style="padding:20px;"><strong><%= txt('volunteer.departments.name3', 'Prayer & Altar Ministry', 'Department 3 — name') %></strong><p style="color:var(--mist); font-size:13.5px; margin-top:6px;"><%= txt('volunteer.departments.desc3', 'Stand with guests at the altar and prayer room.', 'Department 3 — description') %></p></div>
        <div class="card" style="padding:20px;"><strong><%= txt('volunteer.departments.name4', 'Logistics & Security', 'Department 4 — name') %></strong><p style="color:var(--mist); font-size:13.5px; margin-top:6px;"><%= txt('volunteer.departments.desc4', 'Crowd flow, parking and venue coordination.', 'Department 4 — description') %></p></div>
        <div class="card" style="padding:20px;"><strong><%= txt('volunteer.departments.name5', 'Registration Desk', 'Department 5 — name') %></strong><p style="color:var(--mist); font-size:13.5px; margin-top:6px;"><%= txt('volunteer.departments.desc5', 'Check guests in and issue QR tickets.', 'Department 5 — description') %></p></div>
        <div class="card" style="padding:20px;"><strong><%= txt('volunteer.departments.name6', 'Hospitality', 'Department 6 — name') %></strong><p style="color:var(--mist); font-size:13.5px; margin-top:6px;"><%= txt('volunteer.departments.desc6', 'Care for speakers, ministers and VIP guests.', 'Department 6 — description') %></p></div>
      </div>
      <div class="pill" style="margin-top:26px;"><%= txt('volunteer.departments.note', 'All volunteers are added to our WhatsApp coordination group after signup', 'Note under the list') %></div>
    </div>

    <div class="panel-dark reveal">
      <span class="eyebrow"><%= txt('volunteer.form.eyebrow', 'Apply now', 'Application form — small label') %></span>
      <h3 style="margin:14px 0 22px;"><%= txt('volunteer.form.title', 'Volunteer Application', 'Application form — heading') %></h3>
      <form data-api-form data-endpoint="/api/volunteers/apply" data-success="<%= txt('volunteer.form.successMessage', 'Application received — welcome to the team!', 'Message shown after the form is sent') %>">
        <div class="field-row">
          <div class="field"><label><%= txt('site.forms.labelFullName', 'Full Name', 'Form label — Full Name') %></label><input type="text" name="fullName" required placeholder="<%= txt('volunteer.placeholders.fullname', 'Your name', 'Placeholder inside the fullName box') %>"></div>
          <div class="field"><label><%= txt('site.forms.labelPhoneNumber', 'Phone Number', 'Form label — Phone Number') %></label><input type="tel" name="phone" required placeholder="<%= txt('volunteer.placeholders.phone', '+234…', 'Placeholder inside the phone box') %>"></div>
        </div>
        <div class="field"><label><%= txt('site.forms.labelEmailAddress', 'Email Address', 'Form label — Email Address') %></label><input type="email" name="email" required placeholder="<%= txt('volunteer.placeholders.email', 'you@email.com', 'Placeholder inside the email box') %>"></div>
        <div class="field"><label><%= txt('site.forms.labelPreferredDepartment', 'Preferred Department', 'Form label — Preferred Department') %></label>
          <select name="department">
            <option value="Ushering &amp; Guest Care"><%= txt('volunteer.options.departmentUsheringGuestCare', 'Ushering & Guest Care', 'Dropdown choice (department) — Ushering & Guest Care') %></option>
            <option value="Media &amp; Production"><%= txt('volunteer.options.departmentMediaProduction', 'Media & Production', 'Dropdown choice (department) — Media & Production') %></option>
            <option value="Prayer &amp; Altar Ministry"><%= txt('volunteer.options.departmentPrayerAltarMinistry', 'Prayer & Altar Ministry', 'Dropdown choice (department) — Prayer & Altar Ministry') %></option>
            <option value="Logistics &amp; Security"><%= txt('volunteer.options.departmentLogisticsSecurity', 'Logistics & Security', 'Dropdown choice (department) — Logistics & Security') %></option>
            <option value="Registration Desk"><%= txt('volunteer.options.departmentRegistrationDesk', 'Registration Desk', 'Dropdown choice (department) — Registration Desk') %></option>
            <option value="Hospitality"><%= txt('volunteer.options.departmentHospitality', 'Hospitality', 'Dropdown choice (department) — Hospitality') %></option>
          </select>
        </div>
        <div class="field-row">
          <div class="field"><label><%= txt('site.forms.labelPriorExperience', 'Prior Experience', 'Form label — Prior Experience') %></label><input type="text" name="occupation" placeholder="<%= txt('volunteer.placeholders.occupation', 'e.g. 2 years event ushering', 'Placeholder inside the occupation box') %>"></div>
          <div class="field"><label><%= txt('site.forms.labelAvailability', 'Availability', 'Form label — Availability') %></label>
            <select name="availability">
              <option value="Weekdays"><%= txt('volunteer.options.availabilityWeekdays', 'Weekdays', 'Dropdown choice (availability) — Weekdays') %></option>
              <option value="Weekends"><%= txt('volunteer.options.availabilityWeekends', 'Weekends', 'Dropdown choice (availability) — Weekends') %></option>
              <option value="Anytime"><%= txt('volunteer.options.availabilityAnytime', 'Anytime', 'Dropdown choice (availability) — Anytime') %></option>
            </select>
          </div>
        </div>
        <button class="btn btn-primary btn-block" type="submit"><%= txt('volunteer.form.button', 'Submit Application', 'Application form — button') %></button>
      </form>
    </div>
  </div>
</section>
