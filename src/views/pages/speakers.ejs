<header class="page-header">
  <div class="container">
    <span class="crumb">Home &rsaquo; <span>Speakers</span></span>
    <span class="eyebrow"><%= txt('speakers.intro.eyebrow', 'Line-up', 'Small label at the top') %></span>
    <h1 style="margin-top:18px;"><%= page.heroTitle %></h1>
    <p><%= page.heroSubtitle %></p>
  </div>
</header>

<section class="section-pad">
  <div class="container">
    <div class="grid-4 reveal-stagger">
      <% speakers.forEach(function(speaker) { %>
        <div class="card speaker-card reveal">
          <div class="avatar"><img src="<%= speaker.photo && speaker.photo.url ? speaker.photo.url : '/images/speaker-avatar.jpg' %>" alt="Portrait of <%= speaker.name %>" loading="lazy"></div>
          <div class="body">
            <h4><%= speaker.name %></h4>
            <div class="role"><%= speaker.role %></div>
            <p><%= speaker.bio %></p>
            <div class="speaker-social">
              <% if (speaker.socialLinks && speaker.socialLinks.instagram) { %><a href="<%= speaker.socialLinks.instagram %>" aria-label="Instagram"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a><% } %>
              <% if (speaker.socialLinks && speaker.socialLinks.youtube) { %><a href="<%= speaker.socialLinks.youtube %>" aria-label="YouTube"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9l5 3-5 3V9z" fill="currentColor" stroke="none"/></svg></a><% } %>
              <% if (speaker.socialLinks && speaker.socialLinks.spotify) { %><a href="<%= speaker.socialLinks.spotify %>" aria-label="Spotify"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M7 10c3-1 7-1 10 1M7.5 13c2.5-.8 5.5-.6 8 .8M8 16c2-.6 4.5-.4 6.3.7" stroke-linecap="round"/></svg></a><% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section-pad-sm" style="background:var(--paper-2);">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow"><%= txt('speakers.worship.eyebrow', 'Worship', 'Worship section — small label') %></span>
      <h2><%= txt('speakers.worship.title', 'Listen before you arrive', 'Worship section — heading') %></h2>
      <p><%= txt('speakers.worship.intro', 'Stream GGA worship moments from past gatherings, embedded from Spotify.', 'Worship section — intro line') %></p>
    </div>
    <div class="grid-3 reveal-stagger">
      <div class="card" style="padding:22px;">
        <h4 style="font-size:16px; margin-bottom:10px;"><%= txt('speakers.album1.title', 'Activate — Live at GGA 2025', 'Album 1 — title') %></h4>
        <div style="aspect-ratio:16/9; border-radius:12px; overflow:hidden; position:relative;">
          <img src="<%= cimg('speakers.album1.cover', '/images/album-cover-1.jpg', 'Album 1 — cover picture') %>" alt="Album cover" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
        </div>
      </div>
      <div class="card" style="padding:22px;">
        <h4 style="font-size:16px; margin-bottom:10px;"><%= txt('speakers.album2.title', 'Grace Over Me — Studio Version', 'Album 2 — title') %></h4>
        <div style="aspect-ratio:16/9; border-radius:12px; overflow:hidden; position:relative;">
          <img src="<%= cimg('speakers.album2.cover', '/images/album-cover-2.jpg', 'Album 2 — cover picture') %>" alt="Album cover" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
        </div>
      </div>
      <div class="card" style="padding:22px;">
        <h4 style="font-size:16px; margin-bottom:10px;"><%= txt('speakers.album3.title', 'Nations Arise — Live at GGA 2024', 'Album 3 — title') %></h4>
        <div style="aspect-ratio:16/9; border-radius:12px; overflow:hidden; position:relative;">
          <img src="<%= cimg('speakers.album3.cover', '/images/album-cover-3.jpg', 'Album 3 — cover picture') %>" alt="Album cover" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad">
  <div class="container">
    <div class="panel-dark reveal" style="text-align:center;">
      <span class="eyebrow" style="justify-content:center;"><%= txt('speakers.invite.eyebrow', 'Want to minister at GGA?', 'Invitation box — small label') %></span>
      <h2 style="margin-top:16px; font-size:1.9rem;"><%= txt('speakers.invite.title', 'We\'re always listening for new voices', 'Invitation box — heading') %></h2>
      <p style="color:var(--text); max-width:520px; margin:16px auto 26px;"><%= txt('speakers.invite.body', 'If you sense an invitation to serve at a future Global Grace Activation gathering, we\'d love to hear from you.', 'Invitation box — paragraph') %></p>
      <a href="/contact" class="btn btn-primary"><%= txt('speakers.invite.button', 'Get in Touch', 'Invitation box — button') %></a>
    </div>
  </div>
</section>
