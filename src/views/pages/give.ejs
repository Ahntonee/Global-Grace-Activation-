<header class="page-header">
  <div class="container">
    <span class="crumb">Home &rsaquo; <span>Give</span></span>
    <span class="eyebrow">Give &amp; partner</span>
    <h1 style="margin-top:18px;"><%= page.heroTitle %></h1>
    <p><%= page.heroSubtitle %></p>
  </div>
</header>

<section class="section-pad">
  <div class="container two-col" style="align-items:start;">
    <div class="reveal">
      <span class="eyebrow">Where it goes</span>
      <h2 style="font-size:2rem; margin:16px 0 20px;">Four ways to give</h2>
      <div style="display:flex; flex-direction:column; gap:18px;">
        <div class="card" style="padding:22px;"><h4 style="font-size:17px;">Offering</h4><p style="color:var(--mist); font-size:14.5px; margin-top:6px;">General giving toward the day-to-day work of the movement.</p></div>
        <div class="card" style="padding:22px;"><h4 style="font-size:17px;">Partnership</h4><p style="color:var(--mist); font-size:14.5px; margin-top:6px;">Monthly commitment that sustains GGA's broadcasts and outreach year-round.</p></div>
        <div class="card" style="padding:22px;"><h4 style="font-size:17px;">Project Seed</h4><p style="color:var(--mist); font-size:14.5px; margin-top:6px;">One-time seed toward a specific project &mdash; venue, equipment, or a regional activation.</p></div>
        <div class="card" style="padding:22px;"><h4 style="font-size:17px;">Missions</h4><p style="color:var(--mist); font-size:14.5px; margin-top:6px;">Support for church-planting and outreach teams carrying GGA's message into new nations.</p></div>
        <div class="card" style="padding:22px;"><h4 style="font-size:17px;">Conference Support</h4><p style="color:var(--mist); font-size:14.5px; margin-top:6px;">Directly funds the annual GGA Global Conference, kept free for every attendee.</p></div>
      </div>
    </div>

    <form class="panel-dark reveal" id="give-form">
      <span class="eyebrow">Give now</span>
      <h3 style="margin:14px 0 20px;">Choose an amount</h3>
      <div class="give-toggle" id="give-frequency-toggle">
        <button class="active" type="button" data-frequency="One-Time">One-Time</button>
        <button type="button" data-frequency="Monthly">Monthly</button>
      </div>
      <div class="give-amounts">
        <button class="amt-btn active" type="button" data-amt="10000">&#8358;10,000</button>
        <button class="amt-btn" type="button" data-amt="20000">&#8358;20,000</button>
        <button class="amt-btn" type="button" data-amt="50000">&#8358;50,000</button>
        <button class="amt-btn" type="button" data-amt="100000">&#8358;100,000</button>
        <button class="amt-btn" type="button" data-amt="custom">Custom</button>
        <input type="text" class="custom-amount amt-btn" id="give-custom-amount" placeholder="&#8358; Amount" style="text-align:center;">
      </div>
      <div class="field-row">
        <div class="field"><label>Full Name</label><input type="text" name="fullName" required placeholder="Your name"></div>
        <div class="field"><label>Email Address</label><input type="email" name="email" required placeholder="you@email.com"></div>
      </div>
      <div class="field">
        <label>Giving toward</label>
        <select name="fund">
          <option>Offering</option>
          <option>Partnership</option>
          <option>Project Seed</option>
          <option>Missions</option>
          <option>Conference Support</option>
        </select>
      </div>
      <label style="display:flex; align-items:center; gap:8px; font-size:13px; color:var(--text); margin-bottom:16px;"><input type="checkbox" name="isAnonymous" style="width:auto;"> Give anonymously</label>
      <div class="give-toggle" id="give-provider-toggle">
        <button class="active" type="button" data-provider="paystack">Paystack</button>
        <button type="button" data-provider="flutterwave">Flutterwave</button>
      </div>
      <div class="admin-auth-error" id="give-error" style="margin-top:14px;"></div>
      <button class="btn btn-primary btn-block" type="submit" style="margin-top:16px;">Give Securely Now</button>
      <div class="gateways">
        <span style="font-size:12.5px; color:var(--mist);">We accept</span>
        <span class="gateway-badge">Paystack</span>
        <span class="gateway-badge">Flutterwave</span>
      </div>
      <p style="font-size:12px; color:var(--mist); margin-top:16px;">All transactions are encrypted and processed securely. You'll receive an email receipt instantly.</p>
    </form>
  </div>
</section>

<script src="/give.js"></script>

<section class="section-pad-sm" style="background:var(--paper-2);">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow">Recurring giving</span>
      <h2>Become a monthly partner</h2>
      <p>Monthly partners are the backbone of GGA &mdash; sustaining free broadcasts, translation and outreach between gatherings.</p>
    </div>
    <div class="grid-3 reveal-stagger">
      <div class="card" style="padding:28px; text-align:center;"><h4 style="font-size:18px;">Grace Partner</h4><p style="color:var(--flame-dim); font-family:'Space Mono',monospace; font-weight:700; margin:10px 0;">&#8358;10,000/mo</p><p style="color:var(--mist); font-size:14px;">Monthly partner updates &amp; prayer letter</p></div>
      <div class="card" style="padding:28px; text-align:center; border-color:var(--flame);"><h4 style="font-size:18px;">Destiny Partner</h4><p style="color:var(--flame-dim); font-family:'Space Mono',monospace; font-weight:700; margin:10px 0;">&#8358;25,000/mo</p><p style="color:var(--mist); font-size:14px;">Everything above, plus quarterly video updates</p></div>
      <div class="card" style="padding:28px; text-align:center;"><h4 style="font-size:18px;">Nations Partner</h4><p style="color:var(--flame-dim); font-family:'Space Mono',monospace; font-weight:700; margin:10px 0;">&#8358;100,000/mo</p><p style="color:var(--mist); font-size:14px;">Named recognition at the annual gathering</p></div>
    </div>
  </div>
</section>

<section class="section-pad">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow">Trust &amp; transparency</span>
      <h2>Secure, accountable giving</h2>
    </div>
    <div class="grid-4 reveal-stagger" style="text-align:center;">
      <div class="card" style="padding:26px;"><strong>Bank-level encryption</strong><p style="color:var(--mist); font-size:13.5px; margin-top:8px;">All gifts processed via Paystack &amp; Flutterwave.</p></div>
      <div class="card" style="padding:26px;"><strong>Instant receipt</strong><p style="color:var(--mist); font-size:13.5px; margin-top:8px;">Email confirmation sent for every gift.</p></div>
      <div class="card" style="padding:26px;"><strong>Annual report</strong><p style="color:var(--mist); font-size:13.5px; margin-top:8px;">A yearly summary of how funds were used.</p></div>
      <div class="card" style="padding:26px;"><strong>Cancel anytime</strong><p style="color:var(--mist); font-size:13.5px; margin-top:8px;">Manage or stop recurring giving whenever you like.</p></div>
    </div>
  </div>
</section>
