<header class="page-header">
  <div class="container">
    <span class="crumb"><%= txt('site.nav.home', 'Home', 'Menu — Home') %> &rsaquo; <span><%= txt('site.nav.gallery', 'Gallery', 'Menu — Gallery') %></span></span>
    <span class="eyebrow"><%= txt('gallery.intro.eyebrow', 'Media', 'Small label at the top') %></span>
    <h1 style="margin-top:18px;"><%= page.heroTitle %></h1>
    <p><%= page.heroSubtitle %></p>
  </div>
</header>

<section class="section-pad">
  <div class="container">
    <div class="tab-bar reveal" id="gallery-tabs">
      <button class="tab-btn active" type="button" data-filter="all"><%= txt('gallery.tabs.all', 'All', 'Filter tab — All') %></button>
      <button class="tab-btn" type="button" data-filter="photo"><%= txt('gallery.tabs.photos', 'Photos', 'Filter tab — Photos') %></button>
      <button class="tab-btn" type="button" data-filter="video"><%= txt('gallery.tabs.videos', 'Videos', 'Filter tab — Videos') %></button>
      <button class="tab-btn" type="button" data-filter="highlight"><%= txt('gallery.tabs.highlights', 'Highlights', 'Filter tab — Highlights') %></button>
    </div>
    <div class="gallery-grid reveal-stagger" id="gallery-grid">
      <% tiles.forEach(function(t) { %>
        <% if (t.videoUrl) { %>
          <a class="gallery-item<%= t.wide ? ' wide' : '' %>" data-cat="<%= t.category %>" data-caption="<%= t.caption %>" href="<%= t.videoUrl %>" target="_blank" rel="noopener noreferrer"><img src="<%= t.src %>" alt="<%= t.caption %>" loading="lazy"><div class="play" style="position:absolute;inset:0;margin:auto;width:56px;height:56px;border-radius:50%;background:rgba(6,78,59,.78);display:flex;align-items:center;justify-content:center;"><svg width="22" height="22" viewBox="0 0 24 24" fill="#fff" style="width:22px;color:#fff;"><path d="M8 5v14l11-7z"/></svg></div><% if (t.caption) { %><div class="overlay"><span><%= t.caption %></span></div><% } %></a>
        <% } else { %>
          <div class="gallery-item<%= t.wide ? ' wide' : '' %>" data-cat="<%= t.category %>" data-caption="<%= t.caption %>"><img src="<%= t.src %>" alt="<%= t.caption %>" loading="lazy"><% if (t.caption) { %><div class="overlay"><span><%= t.caption %></span></div><% } %></div>
        <% } %>
      <% }) %>
    </div>
    <% if (!tiles.length) { %>
      <p style="color:var(--mist); text-align:center;"><%= txt('gallery.list.empty', 'No photos have been added yet — check back soon.', 'Message when the gallery is empty') %></p>
    <% } %>
    <div style="text-align:center; margin-top:44px;">
      <button class="btn btn-outline-dark" type="button" id="gallery-more" style="display:none;"><%= txt('gallery.list.loadMore', 'Load More', 'Load More button') %></button>
    </div>
  </div>
</section>

<script nonce="<%= nonce %>">
  // Tabs filter the grid; "Load More" reveals the next batch of tiles.
  (function () {
    var PAGE = 12;
    var grid = document.getElementById('gallery-grid');
    var more = document.getElementById('gallery-more');
    var tabs = document.querySelectorAll('#gallery-tabs .tab-btn');
    if (!grid) return;
    var tiles = Array.prototype.slice.call(grid.children);
    var cat = 'all';
    var shown = PAGE;

    function render() {
      var matching = tiles.filter(function (t) { return cat === 'all' || t.getAttribute('data-cat') === cat; });
      tiles.forEach(function (t) { t.style.display = 'none'; });
      matching.forEach(function (t, i) { t.style.display = i < shown ? '' : 'none'; });
      if (more) more.style.display = matching.length <= shown ? 'none' : '';
    }
    tabs.forEach(function (b) {
      b.addEventListener('click', function () {
        tabs.forEach(function (x) { x.classList.remove('active'); });
        b.classList.add('active');
        cat = b.getAttribute('data-filter');
        shown = PAGE;
        render();
      });
    });
    if (more) more.addEventListener('click', function () { shown += PAGE; render(); });
    render();
  })();
</script>

<section class="section-pad-sm" style="background:var(--paper-2);">
  <div class="container">
    <div class="panel-dark reveal" style="text-align:center;">
      <span class="eyebrow" style="justify-content:center;"><%= txt('gallery.press.eyebrow', 'Downloads', 'Press kit box — small label') %></span>
      <h2 style="margin-top:16px; font-size:1.8rem;"><%= txt('gallery.press.title', 'Media & press kit', 'Press kit box — heading') %></h2>
      <p style="color:var(--text); max-width:480px; margin:16px auto 26px;"><%= txt('gallery.press.body', 'Logos, approved photography and highlight reels available for press and partner churches.', 'Press kit box — paragraph') %></p>
      <a href="/contact" class="btn btn-primary"><%= txt('gallery.press.button', 'Request Press Kit', 'Press kit box — button') %></a>
    </div>
  </div>
</section>
