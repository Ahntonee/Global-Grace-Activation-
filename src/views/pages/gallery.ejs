<header class="page-header">
  <div class="container">
    <span class="crumb">Home &rsaquo; <span>Gallery</span></span>
    <span class="eyebrow">Media</span>
    <h1 style="margin-top:18px;"><%= page.heroTitle %></h1>
    <p><%= page.heroSubtitle %></p>
  </div>
</header>

<section class="section-pad">
  <div class="container">
    <div class="tab-bar reveal">
      <button class="tab-btn active" type="button">All</button>
      <button class="tab-btn" type="button">Photos</button>
      <button class="tab-btn" type="button">Videos</button>
      <button class="tab-btn" type="button">Highlights</button>
    </div>
    <div class="gallery-grid reveal-stagger">
      <div class="gallery-item wide" data-caption="GGA 2025 — Opening Night"><img src="/images/worship-crowd-1.jpg" alt="GGA 2025 — Opening Night" loading="lazy"><div class="overlay"><span>GGA 2025 &mdash; Opening Night</span></div></div>
      <div class="gallery-item" data-caption="Worship Under the Lights"><img src="/images/worship-stage.jpg" alt="Worship Under the Lights" loading="lazy"><div class="overlay"><span>Worship Under the Lights</span></div></div>
      <div class="gallery-item" data-caption="Altar Call, Night Two"><img src="/images/conference-arena.jpg" alt="Altar Call, Night Two" loading="lazy"><div class="overlay"><span>Altar Call, Night Two</span></div></div>
      <div class="gallery-item" data-caption="Nations Flag Procession"><img src="/images/worship-team.jpg" alt="Nations Flag Procession" loading="lazy"><div class="overlay"><span>Nations Flag Procession</span></div></div>
      <div class="gallery-item" data-caption="Prayer Room Moments"><img src="/images/prayer-hands.jpg" alt="Prayer Room Moments" loading="lazy"><div class="overlay"><span>Prayer Room Moments</span></div></div>
      <div class="gallery-item wide" data-caption="Crowd at Solution Arena"><img src="/images/worship-crowd-2.jpg" alt="Crowd at Solution Arena" loading="lazy"><div class="overlay"><span>Crowd at Solution Arena</span></div></div>
      <div class="gallery-item" data-caption="Backstage with the Team"><img src="/images/prayer-gathering.jpg" alt="Backstage with the Team" loading="lazy"><div class="overlay"><span>Backstage with the Team</span></div></div>
      <div class="gallery-item" data-caption="Volunteer Squad 2025"><img src="/images/hero-bg.jpg" alt="Volunteer Squad 2025" loading="lazy"><div class="overlay"><span>Volunteer Squad 2025</span></div></div>
      <div class="gallery-item" data-caption="Highlight Reel — Night One"><img src="/images/pastor-podium.jpg" alt="Highlight Reel — Night One" loading="lazy"><div class="overlay"><span>Highlight Reel &mdash; Night One</span></div></div>
      <div class="gallery-item" data-caption="Kids Activation Corner"><img src="/images/speaker-avatar.jpg" alt="Kids Activation Corner" loading="lazy"><div class="overlay"><span>Kids Activation Corner</span></div></div>
    </div>
    <div style="text-align:center; margin-top:44px;">
      <button class="btn btn-outline-dark" type="button">Load More</button>
    </div>
  </div>
</section>

<section class="section-pad-sm" style="background:var(--paper-2);">
  <div class="container">
    <div class="panel-dark reveal" style="text-align:center;">
      <span class="eyebrow" style="justify-content:center;">Downloads</span>
      <h2 style="margin-top:16px; font-size:1.8rem;">Media &amp; press kit</h2>
      <p style="color:var(--text); max-width:480px; margin:16px auto 26px;">Logos, approved photography and highlight reels available for press and partner churches.</p>
      <a href="/contact" class="btn btn-primary">Request Press Kit</a>
    </div>
  </div>
</section>
