<header class="page-header">
  <div class="container">
    <span class="crumb"><%= txt('site.nav.home', 'Home', 'Menu — Home') %> &rsaquo; <span><%= txt('site.nav.events', 'Events', 'Menu — Events') %></span></span>
    <span class="eyebrow"><%= txt('events.intro.eyebrow', 'Gatherings', 'Small label at the top') %></span>
    <h1 style="margin-top:18px;"><%= page.heroTitle %></h1>
    <p><%= page.heroSubtitle %></p>
  </div>
</header>

<% if (featuredEvent) { %>
<section class="section-pad">
  <div class="container">
    <div class="two-col" style="align-items:start;">
      <div class="reveal">
        <span class="eyebrow"><%= txt('events.flagship.eyebrow', 'Flagship 2026', 'Featured event — small label') %></span>
        <h2 style="font-size:2rem; margin:16px 0 20px;"><%= featuredEvent.title %></h2>
        <p style="color:var(--mist); font-size:16px; margin-bottom:22px;"><%= featuredEvent.description %></p>
        <ul class="hero-meta" style="color:var(--text); gap:14px; margin-bottom:28px;">
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> <%= featuredEvent.startDate.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s7-7.4 7-12.5A7 7 0 0 0 5 9.5C5 14.6 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.5"/></svg> <%= featuredEvent.location %></li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path d="M2 20c0-3.3 3-6 7-6s7 2.7 7 6"/><circle cx="18" cy="9" r="2.4"/><path d="M16 14.2c2.6.5 4.5 2.4 4.5 5.3"/></svg> <%= txt('events.flagship.perk', 'Open to all · free registration', 'Featured event — note under the date') %></li>
        </ul>
        <div style="display:flex; gap:14px; flex-wrap:wrap;">
          <a href="#register" class="btn btn-primary js-register-btn" data-event="<%= featuredEvent.title %>" data-event-id="<%= featuredEvent._id %>"><%= txt('site.nav.registerButton', 'Register Now', 'Header button — Register Now') %></a>
        </div>
      </div>
      <div class="hero-panel" style="border-radius:var(--radius-lg);">
        <span class="eyebrow"><%= txt('events.countdown.eyebrow', 'Countdown', 'Countdown card — small label') %></span>
        <h3 style="margin:14px 0 20px;"><%= txt('events.countdown.title', 'Time until we gather', 'Countdown card — heading') %></h3>
        <div class="countdown" data-event-date="<%= featuredEvent.startDate.toISOString() %>">
          <div class="c-cell"><div class="c-num" id="cd-days">00</div><div class="c-label"><%= txt('site.countdown.days', 'Days', 'Countdown label — Days') %></div></div>
          <div class="c-cell"><div class="c-num" id="cd-hours">00</div><div class="c-label"><%= txt('site.countdown.hours', 'Hours', 'Countdown label — Hours') %></div></div>
          <div class="c-cell"><div class="c-num" id="cd-mins">00</div><div class="c-label"><%= txt('site.countdown.mins', 'Mins', 'Countdown label — Mins') %></div></div>
          <div class="c-cell"><div class="c-num" id="cd-secs">00</div><div class="c-label"><%= txt('site.countdown.secs', 'Secs', 'Countdown label — Secs') %></div></div>
        </div>
        <div class="map-frame" style="height:180px; background:linear-gradient(155deg,#ecfdf5,#f0fdf4); position:relative; overflow:hidden;">
          <img src="<%= cimg('events.venue.image', '/images/venue-aerial.jpg', 'Venue photo (under the countdown)') %>" alt="Aerial view of Solution Arena venue" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--mist);background:rgba(255,255,255,.6);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2z"/></svg> <%= txt('events.venue.caption', '  Venue map — Solution Arena, Lagos', 'Venue photo caption') %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<% } %>

<% if (featuredEvent && featuredEvent.flyers && featuredEvent.flyers.length) { %>
<section class="section-pad-sm">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow"><%= txt('events.flyers.eyebrow', 'Event flyers', 'Flyers section — small label') %></span>
      <h2><%= featuredEvent.title %></h2>
    </div>
    <div class="flyer-grid reveal">
      <% featuredEvent.flyers.forEach(function(f, i) { if (!f || !f.url) return; %>
        <a href="<%= f.url %>" target="_blank" rel="noopener"><img src="<%= f.url %>" alt="<%= featuredEvent.title %> flyer <%= i + 1 %>" loading="lazy"></a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (addons && addons.length) { %>
<section class="section-pad">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow"><%= txt('events.addons.eyebrow', 'Upgrade your seat', 'Add-ons section — small label') %></span>
      <h2><%= txt('events.addons.title', 'Event add-ons', 'Add-ons section — heading') %></h2>
      <p><%= txt('events.addons.lead', 'Optional extras for', 'Add-ons section — wording before the event name') %> <%= featuredEvent.title %>.</p>
    </div>
    <div class="grid-3 reveal-stagger">
      <% addons.forEach(function(p) { %>
        <a href="/shop/<%= p.slug %>" class="card blog-card">
          <div class="thumb"><img src="<%= p.images && p.images[0] && p.images[0].url ? p.images[0].url : '/images/conference-arena.jpg' %>" alt="<%= p.name %>" loading="lazy"></div>
          <div class="body">
            <span class="tag"><%= txt('events.addons.tag', 'Add-on', 'Tag on each add-on card') %></span>
            <h4><%= p.name %></h4>
            <p><%= p.shortDescription || p.description %></p>
            <div class="meta"><span style="font-weight:700; color:var(--flame-dim); font-family:'Space Mono',monospace;">&#8358;<%= p.price.toLocaleString() %></span></div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section-pad-sm" style="background:var(--paper-2);" id="register">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow"><%= txt('events.upcoming.eyebrow', 'Upcoming', 'Upcoming list — small label') %></span>
      <h2><%= txt('events.upcoming.title', 'All upcoming events', 'Upcoming list — heading') %></h2>
    </div>
    <div id="upcoming-list" style="display:flex; flex-direction:column; gap:18px;">
      <% upcoming.forEach(function(ev) { %>
        <div class="card event-card reveal">
          <div class="date-badge">
            <div class="d"><%= ev.startDate.getDate() %></div>
            <div class="m"><%= ev.startDate.toLocaleDateString('en-US',{month:'short'}) %></div>
          </div>
          <div class="info">
            <h4><%= ev.title %></h4>
            <div class="meta-row">
              <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> <%= ev.startDate.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'}) %></span>
              <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s7-7.4 7-12.5A7 7 0 0 0 5 9.5C5 14.6 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.5"/></svg> <%= ev.location %></span>
            </div>
            <% if (ev.flyers && ev.flyers.length) { %>
              <div class="flyer-thumbs">
                <% ev.flyers.forEach(function(f, i) { if (!f || !f.url) return; %>
                  <a href="<%= f.url %>" target="_blank" rel="noopener" title="View flyer <%= i + 1 %>"><img src="<%= f.url %>" alt="<%= ev.title %> flyer <%= i + 1 %>" loading="lazy"></a>
                <% }) %>
              </div>
            <% } %>
            <% if (ev.isVirtual && ev.meetingLink) { %>
              <a href="<%= ev.meetingLink %>" class="btn btn-sm btn-outline-dark"><%= txt('events.list.watchButton', 'Watch Live', 'Button on online events') %></a>
            <% } else { %>
              <a href="#" class="btn btn-sm btn-primary js-register-btn" data-event="<%= ev.title %>" data-event-id="<%= ev._id %>"><%= txt('events.list.registerButton', 'Register', 'Button on each upcoming event') %></a>
            <% } %>
          </div>
        </div>
      <% }) %>
      <% if (!upcoming.length) { %>
        <p style="color:var(--mist); text-align:center;"><%= txt('events.list.empty', 'No upcoming events scheduled right now — check back soon.', 'Message when there are no upcoming events') %></p>
      <% } %>
    </div>
  </div>
</section>

<% if (past.length) { %>
<section class="section-pad">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow"><%= txt('events.archive.eyebrow', 'Archive', 'Past events — small label') %></span>
      <h2><%= txt('events.archive.title', 'Previous events', 'Past events — heading') %></h2>
      <p><%= txt('events.archive.intro', 'Relive the moves of God from past gatherings.', 'Past events — intro line') %></p>
    </div>
    <div class="grid-3 reveal-stagger">
      <% past.forEach(function(ev) { %>
        <div class="card blog-card">
          <div class="thumb"><img src="<%= firstImage(ev.flyers, ev.featuredImage, '/images/conference-arena.jpg') %>" alt="<%= ev.title %>" loading="lazy"></div>
          <div class="body">
            <span class="tag"><%= ev.startDate.getFullYear() %></span>
            <h4><%= ev.title %></h4>
            <p><%= ev.description %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (faqs.length) { %>
<section class="section-pad-sm" style="background:var(--paper-2);">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow"><%= txt('events.faq.eyebrow', 'FAQs', 'FAQ section — small label') %></span>
      <h2><%= txt('events.faq.title', 'Good to know before you register', 'FAQ section — heading') %></h2>
    </div>
    <div style="max-width:760px; margin:0 auto;">
      <% faqs.forEach(function(faq) { %>
        <div class="accordion-item reveal">
          <button><%= faq.question %> <span class="plus">+</span></button>
          <div class="a-body"><p><%= faq.answer %></p></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
