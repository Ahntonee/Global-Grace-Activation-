<header class="page-header">
  <div class="container">
    <span class="crumb">Home &rsaquo; <span>Events</span></span>
    <span class="eyebrow">Gatherings</span>
    <h1 style="margin-top:18px;"><%= page.heroTitle %></h1>
    <p><%= page.heroSubtitle %></p>
  </div>
</header>

<% if (featuredEvent) { %>
<section class="section-pad">
  <div class="container">
    <div class="two-col" style="align-items:start;">
      <div class="reveal">
        <span class="eyebrow">Flagship 2026</span>
        <h2 style="font-size:2rem; margin:16px 0 20px;"><%= featuredEvent.title %></h2>
        <p style="color:var(--mist); font-size:16px; margin-bottom:22px;"><%= featuredEvent.description %></p>
        <ul class="hero-meta" style="color:var(--text); gap:14px; margin-bottom:28px;">
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> <%= featuredEvent.startDate.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s7-7.4 7-12.5A7 7 0 0 0 5 9.5C5 14.6 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.5"/></svg> <%= featuredEvent.location %></li>
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path d="M2 20c0-3.3 3-6 7-6s7 2.7 7 6"/><circle cx="18" cy="9" r="2.4"/><path d="M16 14.2c2.6.5 4.5 2.4 4.5 5.3"/></svg> Open to all &middot; free registration</li>
        </ul>
        <div style="display:flex; gap:14px; flex-wrap:wrap;">
          <a href="#register" class="btn btn-primary js-register-btn" data-event="<%= featuredEvent.title %>" data-event-id="<%= featuredEvent._id %>">Register Now</a>
        </div>
      </div>
      <div class="hero-panel" style="border-radius:var(--radius-lg);">
        <span class="eyebrow">Countdown</span>
        <h3 style="margin:14px 0 20px;">Time until we gather</h3>
        <div class="countdown" data-event-date="<%= featuredEvent.startDate.toISOString() %>">
          <div class="c-cell"><div class="c-num" id="cd-days">00</div><div class="c-label">Days</div></div>
          <div class="c-cell"><div class="c-num" id="cd-hours">00</div><div class="c-label">Hours</div></div>
          <div class="c-cell"><div class="c-num" id="cd-mins">00</div><div class="c-label">Mins</div></div>
          <div class="c-cell"><div class="c-num" id="cd-secs">00</div><div class="c-label">Secs</div></div>
        </div>
        <div class="map-frame" style="height:180px; background:linear-gradient(155deg,#ecfdf5,#f0fdf4); position:relative; overflow:hidden;">
          <img src="/images/venue-aerial.jpg" alt="Aerial view of Solution Arena venue" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--mist);background:rgba(255,255,255,.6);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2z"/></svg> &nbsp; Venue map &mdash; Solution Arena, Lagos
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<% } %>

<% if (featuredEvent && featuredEvent.flyers && featuredEvent.flyers.length) { %>
<section class="section-pad-sm">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow">Event flyers</span>
      <h2><%= featuredEvent.title %></h2>
    </div>
    <div class="flyer-grid reveal">
      <% featuredEvent.flyers.forEach(function(f, i) { if (!f || !f.url) return; %>
        <a href="<%= f.url %>" target="_blank" rel="noopener"><img src="<%= f.url %>" alt="<%= featuredEvent.title %> flyer <%= i + 1 %>" loading="lazy"></a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (addons && addons.length) { %>
<section class="section-pad">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow">Upgrade your seat</span>
      <h2>Event add-ons</h2>
      <p>Optional extras for <%= featuredEvent.title %>.</p>
    </div>
    <div class="grid-3 reveal-stagger">
      <% addons.forEach(function(p) { %>
        <a href="/shop/<%= p.slug %>" class="card blog-card">
          <div class="thumb"><img src="<%= p.images && p.images[0] && p.images[0].url ? p.images[0].url : '/images/conference-arena.jpg' %>" alt="<%= p.name %>" loading="lazy"></div>
          <div class="body">
            <span class="tag">Add-on</span>
            <h4><%= p.name %></h4>
            <p><%= p.shortDescription || p.description %></p>
            <div class="meta"><span style="font-weight:700; color:var(--flame-dim); font-family:'Space Mono',monospace;">&#8358;<%= p.price.toLocaleString() %></span></div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section-pad-sm" style="background:var(--paper-2);" id="register">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow">Upcoming</span>
      <h2>All upcoming events</h2>
    </div>
    <div id="upcoming-list" style="display:flex; flex-direction:column; gap:18px;">
      <% upcoming.forEach(function(ev) { %>
        <div class="card event-card reveal">
          <div class="date-badge">
            <div class="d"><%= ev.startDate.getDate() %></div>
            <div class="m"><%= ev.startDate.toLocaleDateString('en-US',{month:'short'}) %></div>
          </div>
          <div class="info">
            <h4><%= ev.title %></h4>
            <div class="meta-row">
              <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> <%= ev.startDate.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'}) %></span>
              <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s7-7.4 7-12.5A7 7 0 0 0 5 9.5C5 14.6 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.5"/></svg> <%= ev.location %></span>
            </div>
            <% if (ev.flyers && ev.flyers.length) { %>
              <div class="flyer-thumbs">
                <% ev.flyers.forEach(function(f, i) { if (!f || !f.url) return; %>
                  <a href="<%= f.url %>" target="_blank" rel="noopener" title="View flyer <%= i + 1 %>"><img src="<%= f.url %>" alt="<%= ev.title %> flyer <%= i + 1 %>" loading="lazy"></a>
                <% }) %>
              </div>
            <% } %>
            <% if (ev.isVirtual && ev.meetingLink) { %>
              <a href="<%= ev.meetingLink %>" class="btn btn-sm btn-outline-dark">Watch Live</a>
            <% } else { %>
              <a href="#" class="btn btn-sm btn-primary js-register-btn" data-event="<%= ev.title %>" data-event-id="<%= ev._id %>">Register</a>
            <% } %>
          </div>
        </div>
      <% }) %>
      <% if (!upcoming.length) { %>
        <p style="color:var(--mist); text-align:center;">No upcoming events scheduled right now — check back soon.</p>
      <% } %>
    </div>
  </div>
</section>

<% if (past.length) { %>
<section class="section-pad">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow">Archive</span>
      <h2>Previous events</h2>
      <p>Relive the moves of God from past gatherings.</p>
    </div>
    <div class="grid-3 reveal-stagger">
      <% past.forEach(function(ev) { %>
        <div class="card blog-card">
          <div class="thumb"><img src="<%= firstImage(ev.flyers, ev.featuredImage, '/images/conference-arena.jpg') %>" alt="<%= ev.title %>" loading="lazy"></div>
          <div class="body">
            <span class="tag"><%= ev.startDate.getFullYear() %></span>
            <h4><%= ev.title %></h4>
            <p><%= ev.description %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (faqs.length) { %>
<section class="section-pad-sm" style="background:var(--paper-2);">
  <div class="container">
    <div class="center-head reveal">
      <span class="eyebrow">FAQs</span>
      <h2>Good to know before you register</h2>
    </div>
    <div style="max-width:760px; margin:0 auto;">
      <% faqs.forEach(function(faq) { %>
        <div class="accordion-item reveal">
          <button><%= faq.question %> <span class="plus">+</span></button>
          <div class="a-body"><p><%= faq.answer %></p></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
