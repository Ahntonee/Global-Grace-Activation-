<header class="page-header">
  <div class="container">
    <span class="crumb">Home &rsaquo; <span>Shop</span></span>
    <span class="eyebrow">Store</span>
    <h1 style="margin-top:18px;">Resources &amp; merchandise.</h1>
    <p>Merch, books, worship albums and digital downloads — every purchase supports the movement.</p>
  </div>
</header>

<section class="section-pad">
  <div class="container">
    <div class="grid-4 reveal-stagger">
      <% products.forEach(function(p) { %>
        <a href="/shop/<%= p.slug %>" class="card blog-card">
          <div class="thumb"><img src="<%= p.images && p.images[0] && p.images[0].url ? p.images[0].url : '/images/worship-stage.jpg' %>" alt="<%= p.name %>" loading="lazy"></div>
          <div class="body">
            <span class="tag"><%= p.type === 'digital' ? 'Digital Download' : 'Merchandise' %></span>
            <h4><%= p.name %></h4>
            <p><%= p.shortDescription || p.description %></p>
            <div class="meta"><span style="font-weight:700; color:var(--flame-dim); font-family:'Space Mono',monospace;">&#8358;<%= p.price.toLocaleString() %></span></div>
          </div>
        </a>
      <% }) %>
      <% if (!products.length) { %>
        <p style="color:var(--mist);">No products available yet — check back soon.</p>
      <% } %>
    </div>
  </div>
</section>
