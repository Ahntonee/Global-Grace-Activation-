<header class="page-header">
  <div class="container">
    <span class="crumb">Home &rsaquo; <span>Order Confirmation</span></span>
    <span class="eyebrow">Order status</span>
    <h1 style="margin-top:18px;" id="confirmation-heading">Checking your order&hellip;</h1>
    <p id="confirmation-sub">Reference: <%= reference %></p>
  </div>
</header>

<section class="section-pad">
  <div class="container" style="max-width:640px;">
    <div class="panel-dark reveal" id="confirmation-body">
      <p style="color:var(--mist);">Loading order details&hellip;</p>
    </div>
    <div style="text-align:center; margin-top:30px;">
      <a href="/shop" class="btn btn-outline-dark">Continue Shopping</a>
    </div>
  </div>
</section>

<script nonce="<%= nonce %>">
  window.__ORDER_REFERENCE__ = <%- JSON.stringify(reference) %>;
</script>
<script src="/order-confirmation.js"></script>
