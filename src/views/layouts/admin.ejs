<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title + ' — Admin | GGA' : 'Admin | Global Grace Activation' %></title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" type="image/png" href="/images/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="/styles.css">
<link rel="stylesheet" href="/admin-assets/admin.css">
</head>
<body class="admin-body">
<% if (typeof user !== 'undefined' && user) { %>
<div class="admin-shell">
  <aside class="admin-sidebar">
    <a href="/admin" class="admin-brand">
      <span class="flame-mark" style="width:30px;height:30px;"><img src="/images/logo.png" alt="Global Grace Activation" style="width:100%;height:100%;object-fit:contain;"></span>
      <span>GGA Admin</span>
    </a>
    <nav class="admin-nav">
      <div class="admin-nav-group">
        <a href="/admin" class="<%= currentModule === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      </div>
      <div class="admin-nav-group">
        <span class="admin-nav-label">Content</span>
        <a href="/admin/pages" class="<%= currentModule === 'pages' ? 'active' : '' %>">Pages</a>
        <a href="/admin/blogs" class="<%= currentModule === 'blogs' ? 'active' : '' %>">Blog Posts</a>
        <a href="/admin/events" class="<%= currentModule === 'events' ? 'active' : '' %>">Events</a>
        <a href="/admin/speakers" class="<%= currentModule === 'speakers' ? 'active' : '' %>">Speakers</a>
        <a href="/admin/testimonies" class="<%= currentModule === 'testimonies' ? 'active' : '' %>">Testimonies</a>
        <a href="/admin/faqs" class="<%= currentModule === 'faqs' ? 'active' : '' %>">FAQs</a>
        <a href="/admin/media" class="<%= currentModule === 'media' ? 'active' : '' %>">Media Library</a>
      </div>
      <div class="admin-nav-group">
        <span class="admin-nav-label">Shop &amp; Giving</span>
        <a href="/admin/products" class="<%= currentModule === 'products' ? 'active' : '' %>">Products</a>
        <a href="/admin/orders" class="<%= currentModule === 'orders' ? 'active' : '' %>">Orders</a>
        <a href="/admin/donations" class="<%= currentModule === 'donations' ? 'active' : '' %>">Donations</a>
      </div>
      <div class="admin-nav-group">
        <span class="admin-nav-label">Engagement</span>
        <a href="/admin/contacts" class="<%= currentModule === 'contacts' ? 'active' : '' %>">Contact Messages</a>
        <a href="/admin/prayers" class="<%= currentModule === 'prayers' ? 'active' : '' %>">Prayer Requests</a>
        <a href="/admin/volunteers" class="<%= currentModule === 'volunteers' ? 'active' : '' %>">Volunteer Applications</a>
        <a href="/admin/newsletter" class="<%= currentModule === 'newsletter' ? 'active' : '' %>">Newsletter</a>
      </div>
      <div class="admin-nav-group">
        <span class="admin-nav-label">Live</span>
        <a href="/admin/broadcast" class="<%= currentModule === 'broadcast' ? 'active' : '' %>">Broadcast Control</a>
      </div>
    </nav>
    <div class="admin-sidebar-footer">
      <a href="/" target="_blank" rel="noopener">View site &rarr;</a>
    </div>
  </aside>
  <div class="admin-main">
    <header class="admin-topbar">
      <div class="admin-topbar-title"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></div>
      <div class="admin-topbar-user">
        <span><%= user.fullName %> <small>(<%= user.role %>)</small></span>
        <button type="button" id="admin-logout-btn" class="btn btn-sm btn-outline-dark">Log out</button>
      </div>
    </header>
    <main class="admin-content">
      <%- body %>
    </main>
  </div>
</div>
<% } else { %>
  <%- body %>
<% } %>
<script src="/admin-assets/admin.js"></script>
</body>
</html>
