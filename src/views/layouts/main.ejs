<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : 'Global Grace Activation' %></title>
<meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Global Grace Activation — a worldwide movement raised to ignite revival, release destiny, and transform lives through the power of God.' %>">
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Global Grace Activation' %>">
<meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Global Grace Activation — a worldwide movement raised to ignite revival, release destiny, and transform lives through the power of God.' %>">
<meta property="og:type" content="website">
<link rel="icon" type="image/png" href="<%= cimg('site.logo.image', '/images/logo.png', 'Logo (header, footer and browser tab icon)') %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="/styles.css">
<%
  const clientText = {
    registerFor: txt('site.messages.registerFor', 'Register for', 'Registration pop-up — wording before the event name'),
    redirecting: txt('site.messages.redirecting', 'Redirecting to secure checkout…', 'Pop-up message when heading to checkout'),
    openingMedia: txt('site.messages.openingMedia', 'Opening media…', 'Pop-up message when a gallery photo has no caption'),
    formSuccessFallback: txt('site.messages.formSuccessFallback', 'Thank you — received!', 'Default message after any form is sent'),
    formErrorFallback: txt('site.messages.formErrorFallback', 'Something went wrong — please try again.', 'Default message when a form fails'),
    cartAdded: txt('site.messages.cartAdded', 'Added ✓', 'Shop — button wording right after adding to cart'),
    cartEmpty: txt('site.messages.cartEmpty', 'Your cart is empty.', 'Cart — empty message'),
    cartBrowse: txt('site.messages.cartBrowse', 'Browse the shop', 'Cart — link in the empty message'),
    cartRemove: txt('site.messages.cartRemove', 'Remove', 'Cart — remove button'),
    shippingLabel: txt('site.messages.shippingLabel', 'Shipping', 'Checkout — shipping line'),
    giveThanksHeading: txt('site.messages.giveThanksHeading', 'Thank you for giving!', 'Giving result — success heading'),
    giveThanksBody: txt('site.messages.giveThanksBody', 'Your gift of {amount} toward {fund} has been received. An email receipt is on its way.', 'Giving result — success message ({amount} and {fund} are filled in automatically)'),
    payFailedHeading: txt('site.messages.payFailedHeading', 'Payment didn\'t go through.', 'Payment failed — heading (giving and shop)'),
    payFailedBody: txt('site.messages.payFailedBody', 'Your payment was not successful. No charge was made.', 'Payment failed — message (giving and shop)'),
    tryAgain: txt('site.messages.tryAgain', 'Try again', 'Payment failed — link'),
    giveCancelledHeading: txt('site.messages.giveCancelledHeading', 'Payment cancelled', 'Giving cancelled — heading'),
    giveCancelledBody: txt('site.messages.giveCancelledBody', 'You cancelled the payment, so no gift was made.', 'Giving cancelled — message'),
    giveAgain: txt('site.messages.giveAgain', 'Give again', 'Giving cancelled — link'),
    giveCancelledEnd: txt('site.messages.giveCancelledEnd', 'whenever you\'re ready.', 'Giving cancelled — wording after the link'),
    processingHeading: txt('site.messages.processingHeading', 'Still processing…', 'Payment still processing — heading (giving and shop)'),
    giveProcessingBody: txt('site.messages.giveProcessingBody', 'This is taking longer than expected. We\'ll email you a receipt as soon as it clears.', 'Giving still processing — message'),
    giveStatusErrorHeading: txt('site.messages.giveStatusErrorHeading', 'Couldn\'t check status', 'Giving status error — heading'),
    orderConfirmedHeading: txt('site.messages.orderConfirmedHeading', 'Thank you — your order is confirmed!', 'Order result — success heading'),
    orderDigitalItems: txt('site.messages.orderDigitalItems', 'Your digital items:', 'Order result — digital downloads title'),
    orderDownload: txt('site.messages.orderDownload', 'Download', 'Order result — download button wording'),
    orderLinksNote: txt('site.messages.orderLinksNote', 'A copy of these links was also sent to your email.', 'Order result — note under the downloads'),
    orderNumber: txt('site.messages.orderNumber', 'Order', 'Order result — before the order number'),
    orderTotal: txt('site.messages.orderTotal', 'Total:', 'Order result — total wording'),
    orderShippingNote: txt('site.messages.orderShippingNote', 'We\'ll email you shipping updates as your order is processed.', 'Order result — shipping note'),
    orderProcessingBody: txt('site.messages.orderProcessingBody', 'This is taking longer than expected. We\'ll email you a confirmation as soon as it clears.', 'Order still processing — message'),
    orderStatusErrorHeading: txt('site.messages.orderStatusErrorHeading', 'Couldn\'t check order status', 'Order status error — heading'),
  };
%>
<script nonce="<%= nonce %>">
  // Wording used by the page scripts (editable in the admin under Site-wide).
  // ggaT = plain text, ggaH = escaped HTML with {tokens} filled in.
  window.__T = <%- jsonScript(clientText) %>;
  window.ggaT = function (key, fallback) { return (window.__T && window.__T[key]) || fallback; };
  window.ggaH = function (key, fallback, vars) {
    var esc = function (v) { return String(v).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); };
    var out = esc(window.ggaT(key, fallback));
    Object.keys(vars || {}).forEach(function (k) { out = out.split("{" + k + "}").join(vars[k]); });
    return out;
  };
</script>
</head>
<body>
<%- include('../partials/nav', { currentPage: typeof currentPage !== 'undefined' ? currentPage : '' }) %>

<%- body %>

<%- include('../partials/footer') %>

<% if (site.whatsapp) { %><a href="https://wa.me/<%= site.whatsapp %>" class="wa-float" aria-label="Chat on WhatsApp" target="_blank" rel="noopener">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.7.44 3.35 1.29 4.8L2 22l5.44-1.38a9.9 9.9 0 0 0 4.6 1.13h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.13-2.9-7C17.17 3.02 14.69 2 12.04 2zm5.8 14.16c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.8-4.17-4.94-4.36-.14-.2-1.18-1.57-1.18-3 0-1.42.75-2.12 1.01-2.41.27-.29.58-.36.78-.36.2 0 .4 0 .57.01.18.01.43-.07.68.52.24.6.83 2.06.9 2.21.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.03 1.12 1 2.07 1.31 2.36 1.46.3.15.47.13.64-.08.18-.2.75-.88.95-1.18.2-.3.4-.25.66-.15.27.1 1.71.81 2 .96.3.15.49.22.56.35.08.13.08.75-.16 1.44z"/></svg>
</a><% } %>

<%- include('../partials/register-modal') %>

<script src="/script.js"></script>
<script src="/forms.js"></script>
</body>
</html>
