<div class="admin-stats-grid">
  <div class="admin-stat-card"><div class="num"><%= stats.pages %></div><div class="label">Pages</div></div>
  <div class="admin-stat-card"><div class="num"><%= stats.blogs %></div><div class="label">Blog Posts</div></div>
  <div class="admin-stat-card"><div class="num"><%= stats.events %></div><div class="label">Events</div></div>
  <div class="admin-stat-card"><div class="num"><%= stats.speakers %></div><div class="label">Speakers &amp; Leaders</div></div>
  <div class="admin-stat-card"><div class="num"><%= stats.testimonies %></div><div class="label">Testimonies</div></div>
  <div class="admin-stat-card"><div class="num"><%= stats.faqs %></div><div class="label">FAQs</div></div>
  <div class="admin-stat-card"><div class="num"><%= stats.products %></div><div class="label">Products</div></div>
  <div class="admin-stat-card"><div class="num"><%= stats.pendingOrders %></div><div class="label">Orders to Fulfill</div></div>
  <div class="admin-stat-card"><div class="num"><%= stats.totalDonations %></div><div class="label">Successful Donations</div></div>
</div>

<div class="admin-form-card" style="max-width:none;">
  <h2 style="font-size:17px; margin-bottom:14px;">Welcome, <%= user.fullName %></h2>
  <p style="color:var(--mist); font-size:14px; line-height:1.7;">
    Use the sidebar to manage pages, blog posts, events, speakers, testimonies and FAQs — everything
    you edit here updates the live site immediately. The Shop, Giving, Engagement, and Live sections
    are being built next.
  </p>
</div>
