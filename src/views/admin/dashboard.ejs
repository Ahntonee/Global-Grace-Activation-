<div class="admin-toolbar">
  <h2>GGA Admin Dashboard</h2>
</div>

<h3 class="admin-section-title">Overview</h3>
<div class="admin-stats-grid">
  <% cards.forEach(function(card) { %>
    <a class="admin-stat-card" href="<%= card.href %>">
      <div class="num"><%= card.total %></div>
      <div class="label"><%= card.label %></div>
      <% if (card.sub) { %><div class="field-hint" style="margin-top:6px;"><%= card.sub %></div><% } %>
    </a>
  <% }) %>
</div>

<h3 class="admin-section-title">Shortcuts</h3>
<div class="admin-shortcuts">
  <% shortcuts.forEach(function(s) { %>
    <a class="admin-shortcut" href="<%= s.href %>"><strong><%= s.label %></strong><span><%= s.note %></span></a>
  <% }) %>
</div>
