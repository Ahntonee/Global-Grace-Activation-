<div class="admin-toolbar">
  <h2>Donations</h2>
</div>

<div class="admin-stats-grid" id="donation-totals" style="margin-bottom:18px;"></div>

<div class="admin-filters">
  <div>
    <label for="flt-q">Search</label>
    <input type="search" id="flt-q" placeholder="Donor, email, fund…">
  </div>
  <div>
    <label for="flt-from">From date</label>
    <input type="date" id="flt-from">
  </div>
  <div>
    <label for="flt-to">To date</label>
    <input type="date" id="flt-to">
  </div>
  <div>
    <label for="flt-status">Status</label>
    <select id="flt-status">
      <option value="">All</option>
      <option>Successful</option>
      <option>Pending</option>
      <option>Failed</option>
    </select>
  </div>
  <button type="button" class="btn btn-sm btn-outline-dark" id="flt-clear">Clear</button>
  <span class="count" id="flt-count"></span>
  <span class="spacer"></span>
  <div class="admin-export-group">
    <button type="button" class="btn btn-sm btn-primary" data-export="xlsx">Download Excel report</button>
    <button type="button" class="btn btn-sm btn-outline-dark" data-export="csv">Download CSV</button>
  </div>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Donor</th>
        <th>Amount</th>
        <th>Fund</th>
        <th>Frequency</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="donations-body">
      <tr><td colspan="7" class="admin-empty">Loading&hellip;</td></tr>
    </tbody>
  </table>
</div>

<script src="/admin-assets/record-tools.js"></script>
<script src="/admin-assets/donations.js"></script>
