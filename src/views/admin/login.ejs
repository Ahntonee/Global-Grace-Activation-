<div class="admin-auth-wrap">
  <div class="admin-auth-card">
    <span class="flame-mark"><img src="/images/logo.png" alt="Global Grace Activation" style="width:100%;height:100%;object-fit:contain;"></span>
    <h1>Admin sign in</h1>
    <p>Global Grace Activation content management.</p>
    <div class="admin-auth-error" id="login-error"></div>
    <form id="admin-login-form">
      <div class="field">
        <label>Email</label>
        <input type="email" name="email" required placeholder="you@globalgraceactivation.com">
      </div>
      <div class="field">
        <label>Password</label>
        <input type="password" name="password" required placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;">
      </div>
      <button class="btn btn-primary btn-block" type="submit">Sign In</button>
    </form>
  </div>
</div>
<script src="/admin-assets/login.js"></script>
